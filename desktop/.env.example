# Spaces — deployment configuration
#
# Copy to `.env.local` and edit. Every value is optional: with no .env at all
# Spaces runs fully local and asks for a workspace address the first
# time you pair. Nothing here is baked into a component, so a fork can be
# rebranded and repointed without touching source.
#
# These are read at BUILD time by Vite. Anything you can also change at runtime
# in Settings is marked; the runtime value wins.

# Product name in the UI and window title.        (runtime-settable)
VITE_SPACES_BRAND=Spaces
# Shorter form for the sidebar mark and tight spaces.
VITE_SPACES_BRAND_SHORT=Spaces

# Base URL of your paired web workspace — the Next.js app in portal/, deployed
# wherever you like. Leave EMPTY to be prompted on first launch. Do not commit
# a real host here in a public fork: a fresh clone would try to pair with it.
#                                                  (runtime-settable)
VITE_SPACES_PORTAL_URL=

# User-facing name and base URL for the optional generic local HTTP adapter.
# It expects GET /models and POST /chat with an SSE response.
#                                                  (runtime-settable)
VITE_SPACES_LOCAL_AI_NAME=Local AI
VITE_SPACES_LOCAL_AI_URL=http://127.0.0.1:8765

# SQLite filename inside the platform app-data directory. Changing this on an
# existing install starts from an empty database — it does not migrate.
VITE_SPACES_DB_NAME=spaces.db

# Directory Spaces mirrors shared context into, inside each project repository.
# Agents read CONTEXT.md / ROSTER.md / BOARD.md / LINKS.md from here.
VITE_SPACES_CONTEXT_DIR=.hq

# Cosmetic placeholder in file-picker hints.        (runtime-settable)
VITE_SPACES_SAMPLE_PATH=~/code/my-app

# Where "learn more" links point. Empty hides them. (runtime-settable)
VITE_SPACES_DOCS_URL=

# ── Not configurable here ────────────────────────────────────────────────────
#
# The macOS bundle identifier lives in src-tauri/tauri.conf.json and decides
# where the database is stored on disk. Change it in a fork BEFORE first run:
# changing it later points the app at a different, empty app-data directory,
# and your existing database is left behind rather than migrated.
#
# OAuth client credentials for Google / Microsoft / X / TikTok / Meta are held
# by the web workspace as Worker secrets, never by this app. See portal/.
